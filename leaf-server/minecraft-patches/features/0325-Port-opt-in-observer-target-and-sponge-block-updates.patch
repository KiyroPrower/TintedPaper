From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Fri, 13 Nov 2026 08:57:04 -0300
Subject: [PATCH] Port opt-in observer target and sponge block updates

Preserve native reset guards, update ordering and event cancellation. Independently implement the incoming carpet-fixes ports with their disabled defaults; respective creators retain their rights.

diff --git a/net/minecraft/world/level/block/ObserverBlock.java b/net/minecraft/world/level/block/ObserverBlock.java
index 62828f5d5344598c470949b70683efdff0a64099..d76d6301a7478e06188e379b33cf43d5f25cea41 100644
--- a/net/minecraft/world/level/block/ObserverBlock.java
+++ b/net/minecraft/world/level/block/ObserverBlock.java
@@ -128,6 +128,12 @@ public class ObserverBlock extends DirectionalBlock {
             if (!level.isClientSide() && state.getValue(POWERED) && !level.getBlockTicks().hasScheduledTick(pos, this)) {
                 BlockState newState = state.setValue(POWERED, false);
                 level.setBlock(pos, newState, Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+                // TintedPaper start - notify shapes using the state left by reentrant updates
+                if (org.dreeam.leaf.config.modules.opt.DatapackOptimizations.observerPlaceShapeUpdate) {
+                    BlockState current = level.getBlockState(pos);
+                    if (current.is(this)) current.updateNeighbourShapes(level, pos, Block.UPDATE_CLIENTS);
+                }
+                // TintedPaper end
                 this.updateNeighborsInFront(level, pos, newState);
             }
         }
diff --git a/net/minecraft/world/level/block/SpongeBlock.java b/net/minecraft/world/level/block/SpongeBlock.java
index 1c8011985cf43820cdc776f1efcb0e84f0a4464e..dd90289a97f3827595d02e270fc47c3f54f33d91 100644
--- a/net/minecraft/world/level/block/SpongeBlock.java
+++ b/net/minecraft/world/level/block/SpongeBlock.java
@@ -39,7 +39,8 @@ public class SpongeBlock extends Block {
 
     protected void tryAbsorbWater(final Level level, final BlockPos pos) {
         if (this.removeWaterBreadthFirstSearch(level, pos)) {
-            level.setBlock(pos, Blocks.WET_SPONGE.defaultBlockState(), Block.UPDATE_CLIENTS);
+            level.setBlock(pos, Blocks.WET_SPONGE.defaultBlockState(), Block.UPDATE_CLIENTS
+                | (org.dreeam.leaf.config.modules.opt.DatapackOptimizations.spongeAbsorbUpdate ? Block.UPDATE_NEIGHBORS : 0)); // TintedPaper - notify neighbors only after accepted absorption
             level.playSound(null, pos, SoundEvents.SPONGE_ABSORB, SoundSource.BLOCKS, 1.0F, 1.0F);
         }
     }
diff --git a/net/minecraft/world/level/block/TargetBlock.java b/net/minecraft/world/level/block/TargetBlock.java
index 11d59109b8b1c984af036e1edafbc2868573787d..3a6ad83d560689640f01cf8926b7c437015e48eb 100644
--- a/net/minecraft/world/level/block/TargetBlock.java
+++ b/net/minecraft/world/level/block/TargetBlock.java
@@ -135,6 +135,12 @@ public class TargetBlock extends Block {
         if (!level.isClientSide() && !state.is(oldState.getBlock())) {
             if (state.getValue(OUTPUT_POWER) > 0 && !level.getBlockTicks().hasScheduledTick(pos, this)) {
                 level.setBlock(pos, state.setValue(OUTPUT_POWER, 0), Block.UPDATE_CLIENTS | Block.UPDATE_KNOWN_SHAPE);
+                // TintedPaper start - notify shapes using the state left by reentrant updates
+                if (org.dreeam.leaf.config.modules.opt.DatapackOptimizations.targetPlaceShapeUpdate) {
+                    BlockState current = level.getBlockState(pos);
+                    if (current.is(this)) current.updateNeighbourShapes(level, pos, Block.UPDATE_CLIENTS);
+                }
+                // TintedPaper end
             }
         }
     }
