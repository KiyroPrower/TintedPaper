@@ -170,6 +171,59 @@ public class FilePackResources extends AbstractPackMetadataResources implements
         private final File file;
         private @Nullable ZipFile zipFile;
         private boolean failedToLoad;
+        // TintedPaper start - one immutable index per open archive, shared with overlays
+        private @Nullable ZipFile tinted$indexedZip;
+        private List<TintedZipEntry> tinted$index = List.of();
+
+        private record TintedZipEntry(ZipEntry entry, int order) {}
+
+        private Enumeration<? extends ZipEntry> tinted$entries(final ZipFile source, final String prefix) {
+            List<TintedZipEntry> indexed;
+            synchronized (this) {
+                if (this.tinted$indexedZip != source) {
+                    List<TintedZipEntry> entries = new ArrayList<>();
+                    Enumeration<? extends ZipEntry> enumeration = source.entries();
+                    while (enumeration.hasMoreElements()) {
+                        ZipEntry entry = enumeration.nextElement();
+                        if (!entry.isDirectory()) entries.add(new TintedZipEntry(entry, entries.size()));
+                    }
+                    entries.sort(java.util.Comparator.comparing(entry -> entry.entry().getName()));
+                    this.tinted$index = List.copyOf(entries);
+                    this.tinted$indexedZip = source;
+                }
+                indexed = this.tinted$index;
+            }
+            int low = 0;
+            int high = indexed.size();
+            while (low < high) {
+                int middle = (low + high) >>> 1;
+                if (indexed.get(middle).entry().getName().compareTo(prefix) < 0) low = middle + 1;
+                else high = middle;
+            }
+            List<TintedZipEntry> matches = new ArrayList<>();
+            for (int i = low; i < indexed.size(); ++i) {
+                TintedZipEntry entry = indexed.get(i);
+                if (!entry.entry().getName().startsWith(prefix)) break;
+                matches.add(entry);
+            }
+            // Duplicate identifiers and diagnostics retain ZIP enumeration order.
+            matches.sort(java.util.Comparator.comparingInt(TintedZipEntry::order));
+            java.util.Iterator<TintedZipEntry> iterator = matches.iterator();
+            return new Enumeration<ZipEntry>() {
+                @Override
+                public boolean hasMoreElements() {
+                    source.size(); // Preserve native closed-ZIP failures, including closure from a resource callback.
+                    return iterator.hasNext();
+                }
+
+                @Override
+                public ZipEntry nextElement() {
+                    source.size();
+                    return iterator.next().entry();
+                }
+            };
+        }
+        // TintedPaper end
 
         private SharedZipFileAccess(final File file) {
             this.file = file;
@@ -194,7 +248,9 @@ public class FilePackResources extends AbstractPackMetadataResources implements
         }
 
         @Override
-        public void close() {
