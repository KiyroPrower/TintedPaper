+            this.tinted$indexedZip = null; // TintedPaper - release the archive and entry names on close
+            this.tinted$index = List.of(); // TintedPaper
             if (this.zipFile != null) {
                 IOUtils.closeQuietly(this.zipFile);
                 this.zipFile = null;
