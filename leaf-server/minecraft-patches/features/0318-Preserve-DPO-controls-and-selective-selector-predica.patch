+            this.tinted$aliveCheck = null;
+        }
+        // TintedPaper end - DPO selector predicate ordering
         AABB aabb;
         if (this.deltaX == null && this.deltaY == null && this.deltaZ == null) {
             if (this.distance != null && this.distance.max().isPresent()) {
@@ -256,7 +265,8 @@ public class EntitySelectorParser {
                 yield false;
             }
         }) {
-            this.predicates.add(Entity::isAlive);
+            this.tinted$aliveCheck = Entity::isAlive; // TintedPaper - DPO selector predicate ordering
+            this.predicates.add(this.tinted$aliveCheck);
         }
 
         this.suggestions = this::suggestOpenOptions;
