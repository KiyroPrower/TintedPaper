+    @Test
+    @SuppressWarnings("unchecked")
+    void selectorRejectsMissingTagsBeforeReadingHealthButStillRejectsDeadMatches() throws Exception {
+        EntitySelectorOptions.bootStrap();
+        EntitySelector selector = new EntitySelectorParser(new StringReader("@e[tag=tinted]"), true).parse();
+        java.lang.reflect.Field field = EntitySelector.class.getDeclaredField("contextFreePredicates");
+        field.setAccessible(true);
+        List<java.util.function.Predicate<Entity>> predicates = (List<java.util.function.Predicate<Entity>>) field.get(selector);
+        Entity entity = mock(Entity.class);
+        when(entity.entityTags()).thenReturn(java.util.Set.of());
+        assertFalse(predicates.stream().allMatch(predicate -> predicate.test(entity)));
+        verify(entity, never()).isAlive();
+        when(entity.entityTags()).thenReturn(java.util.Set.of("tinted"));
+        when(entity.isAlive()).thenReturn(false);
+        assertFalse(predicates.stream().allMatch(predicate -> predicate.test(entity)));
+        verify(entity).isAlive();
+    }
+
