 @Normal
 class DatapackPortsTest {
+    @Test
+    void dirtPathsCheckTheBlockCarriedByAPiston() {
+        net.minecraft.core.BlockPos pos = net.minecraft.core.BlockPos.ZERO;
+        net.minecraft.world.level.LevelReader level = mock(net.minecraft.world.level.LevelReader.class);
+        net.minecraft.world.level.block.piston.PistonMovingBlockEntity moving = mock(net.minecraft.world.level.block.piston.PistonMovingBlockEntity.class);
+        when(level.getBlockState(pos.above())).thenReturn(net.minecraft.world.level.block.Blocks.MOVING_PISTON.defaultBlockState());
+        when(level.getBlockEntity(pos.above())).thenReturn(moving);
+        net.minecraft.world.level.block.state.BlockState path = net.minecraft.world.level.block.Blocks.DIRT_PATH.defaultBlockState();
+        when(moving.getMovedState()).thenReturn(net.minecraft.world.level.block.Blocks.CARPET.get(net.minecraft.world.item.DyeColor.WHITE).defaultBlockState());
+        assertTrue(path.canSurvive(level, pos));
+        when(moving.getMovedState()).thenReturn(net.minecraft.world.level.block.Blocks.STONE.defaultBlockState());
+        assertFalse(path.canSurvive(level, pos));
+        when(moving.getMovedState()).thenReturn(net.minecraft.world.level.block.Blocks.OAK_FENCE_GATE.defaultBlockState());
+        assertTrue(path.canSurvive(level, pos));
+        when(level.getBlockEntity(pos.above())).thenReturn(null);
+        assertEquals(!net.minecraft.world.level.block.Blocks.MOVING_PISTON.defaultBlockState().isSolid(), path.canSurvive(level, pos));
+    }
+
+    @Test
+    void parsedEmptyContainersNeverShareMutableState() throws Exception {
+        CompoundTag first = TagParser.parseCompoundFully("{entries:[], nested:{}}");
+        CompoundTag second = TagParser.parseCompoundFully("{entries:[], nested:{}}");
+        ((ListTag) first.get("entries")).add(new CompoundTag());
+        ((CompoundTag) first.get("nested")).putInt("value", 1);
+        assertTrue(((ListTag) second.get("entries")).isEmpty());
+        assertTrue(((CompoundTag) second.get("nested")).isEmpty());
+        assertTrue(TagParser.parseCompoundFully("{}").isEmpty());
+    }
