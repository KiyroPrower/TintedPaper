+package org.galemc.gale.configuration;
+
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.serialize.SerializationException;
+
+public final class GaleConfigTestingBase {
+
+    public static void setup(ConfigurationNode node) throws SerializationException {
+        if (GaleGlobalConfiguration.get() == null) {
+            GaleGlobalConfiguration.set(node.require(GaleGlobalConfiguration.class));
+        }
+    }
