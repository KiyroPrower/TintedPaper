@@ -27,6 +27,15 @@ import static org.mockito.Mockito.*;
 class DatapackTagIndexTest {
     private static final EntityTypeTest<Entity, Entity> ANY = EntityTypeTest.forClass(Entity.class);
 
+    @Test
+    void lootPredicatesRetainNativeScanOrderRegardlessOfOptionOrder() throws Exception {
+        net.minecraft.commands.arguments.selector.options.EntitySelectorOptions.bootStrap();
+        for (String selector : List.of("@e[predicate=tinted:test,tag=boss]", "@e[tag=boss,predicate=!tinted:test]")) {
+            assertNull(new net.minecraft.commands.arguments.selector.EntitySelectorParser(new com.mojang.brigadier.StringReader(selector), true).parse().tintedPositiveTags);
+        }
+        assertEquals(List.of("boss"), new net.minecraft.commands.arguments.selector.EntitySelectorParser(new com.mojang.brigadier.StringReader("@e[tag=boss]"), true).parse().tintedPositiveTags);
+    }
+
     private static ServerLevel level() throws Exception {
         ServerLevel level = mock(ServerLevel.class);
         var purpurConfig = Level.class.getField("purpurConfig");
