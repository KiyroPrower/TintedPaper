diff --git a/src/test/java/org/bukkit/craftbukkit/tinted/DivineShapelessGuardTest.java b/src/test/java/org/bukkit/craftbukkit/tinted/DivineShapelessGuardTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..44b06a887696c2e0161809f6508160594c09ed4d
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/tinted/DivineShapelessGuardTest.java
@@ -0,0 +1,92 @@
+package org.bukkit.craftbukkit.tinted;
+
+import java.util.List;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.ItemStackTemplate;
+import net.minecraft.world.item.Items;
+import net.minecraft.world.item.crafting.CraftingBookCategory;
+import net.minecraft.world.item.crafting.CraftingInput;
+import net.minecraft.world.item.crafting.CraftingRecipe;
+import net.minecraft.world.item.crafting.Ingredient;
+import net.minecraft.world.item.crafting.Recipe;
+import net.minecraft.world.item.crafting.ShapelessRecipe;
+import org.bukkit.support.environment.AllFeatures;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+@AllFeatures
+class DivineShapelessGuardTest {
+    @Test
+    void nonBukkitExactIngredientKeepsAlternativeAssignments() {
+        verifyAssignments(Ingredient.ofStacks(List.of(special())));
+    }
+
+    @Test
+    void nonBukkitPredicateIngredientKeepsAlternativeAssignments() {
+        Ingredient ingredient = Ingredient.ofStacks(List.of(special()));
+        ingredient.stackPredicate = stack -> stack.is(Items.STONE) && stack.has(DataComponents.CUSTOM_NAME);
+        verifyAssignments(ingredient);
+    }
+
+    @Test
+    void predicateWithoutExactExamplesCannotUseAnUnmatchedRegularItem() {
+        Ingredient ingredient = Ingredient.of(Items.STONE);
+        ingredient.stackPredicate = stack -> stack.is(Items.STONE) && stack.has(DataComponents.CUSTOM_NAME);
+        verifyAssignments(ingredient);
+    }
+
+    @Test
+    void failingPredicateRestoresTheReusableInputAccounting() {
+        ItemStack named = special();
+        ItemStack plain = new ItemStack(Items.STONE);
+        var input = CraftingInput.of(2, 1, List.of(named, plain));
+        Ingredient failing = Ingredient.ofStacks(List.of(named));
+        failing.stackPredicate = stack -> {
+            if (stack == plain) throw new IllegalStateException("test predicate failure");
+            return true;
+        };
+        assertThrows(IllegalStateException.class, () -> recipe(true, Ingredient.of(Items.STONE), failing).matches(input, null));
+        assertTrue(recipe(true, Ingredient.of(Items.STONE), Ingredient.ofStacks(List.of(named))).matches(input, null));
+    }
+
+    @Test
+    void plainRecipesKeepTheirExistingMatchingAndInputStacks() {
+        var recipe = recipe(false, Ingredient.of(Items.STONE), Ingredient.of(Items.DIRT));
+        var stone = new ItemStack(Items.STONE, 3);
+        var dirt = new ItemStack(Items.DIRT, 2);
+        assertTrue(recipe.matches(CraftingInput.of(2, 1, List.of(dirt, stone)), null));
+        assertFalse(recipe.matches(CraftingInput.of(2, 1, List.of(stone, new ItemStack(Items.DIAMOND))), null));
+        assertEquals(3, stone.getCount());
+        assertEquals(2, dirt.getCount());
+    }
+
+    private static void verifyAssignments(Ingredient restricted) {
+        Ingredient regular = Ingredient.of(Items.STONE);
+        var nativeRecipe = recipe(false, regular, restricted);
+        var bukkitRecipe = recipe(true, regular, restricted);
+        ItemStack named = special();
+        ItemStack plain = new ItemStack(Items.STONE);
+        var forward = CraftingInput.of(2, 1, List.of(named, plain));
+        var reverse = CraftingInput.of(2, 1, List.of(plain, named));
+        assertTrue(bukkitRecipe.matches(forward, null), "Paper's full matcher accepts the assignment");
+        assertTrue(nativeRecipe.matches(forward, null), "The broad slot must leave the named item for the restricted slot");
+        assertTrue(nativeRecipe.matches(reverse, null));
+        assertFalse(nativeRecipe.matches(CraftingInput.of(2, 1, List.of(plain, plain.copy())), null));
+        assertEquals(Component.literal("special"), named.get(DataComponents.CUSTOM_NAME));
+    }
+
+    private static ItemStack special() {
+        var stack = new ItemStack(Items.STONE);
+        stack.set(DataComponents.CUSTOM_NAME, Component.literal("special"));
+        return stack;
+    }
+
+    private static ShapelessRecipe recipe(boolean bukkit, Ingredient... ingredients) {
+        return new ShapelessRecipe(new Recipe.CommonInfo(true),
+            new CraftingRecipe.CraftingBookInfo(CraftingBookCategory.MISC, ""),
+            new ItemStackTemplate(Items.DIAMOND), List.of(ingredients), bukkit);
+    }
+}
