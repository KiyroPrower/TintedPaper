Subject: [PATCH] Cover immutable cube coordinates and Moonrise construction


diff --git a/src/test/java/org/bukkit/craftbukkit/tinted/DatapackPortsTest.java b/src/test/java/org/bukkit/craftbukkit/tinted/DatapackPortsTest.java
index c37db1122b44d5217f450ab8575f11fb3528abc5..b79b9dbd08df31b3d709890b98d62aa1ba5b892b 100644
--- a/src/test/java/org/bukkit/craftbukkit/tinted/DatapackPortsTest.java
+++ b/src/test/java/org/bukkit/craftbukkit/tinted/DatapackPortsTest.java
@@ -36,6 +36,21 @@ import static org.mockito.Mockito.*;
 
 @Normal
 class DatapackPortsTest {
+    @Test
+    void cubeCoordinatesRemainImmutableAndWorkWithMoonriseInitialization() {
+        var shape = new net.minecraft.world.phys.shapes.CubeVoxelShape(new net.minecraft.world.phys.shapes.BitSetDiscreteVoxelShape(2, 4, 8));
+        int parts = 2;
+        for (net.minecraft.core.Direction.Axis axis : net.minecraft.core.Direction.Axis.values()) {
+            var coordinates = shape.getCoords(axis);
+            assertSame(coordinates, shape.getCoords(axis));
+            assertEquals(parts + 1, coordinates.size());
+            assertEquals(1.0D / parts, coordinates.getDouble(1));
+            assertEquals(1.0D, coordinates.getDouble(parts));
+            assertThrows(UnsupportedOperationException.class, () -> coordinates.set(0, 1.0D));
+            parts *= 2;
+        }
+    }
+
