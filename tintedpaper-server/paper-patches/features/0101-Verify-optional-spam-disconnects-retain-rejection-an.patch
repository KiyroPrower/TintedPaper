Subject: [PATCH] Verify optional spam disconnects retain rejection and request
 completion


diff --git a/src/test/java/org/bukkit/craftbukkit/tinted/DivineSpamPolicyTest.java b/src/test/java/org/bukkit/craftbukkit/tinted/DivineSpamPolicyTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..5f650142731d6d5cdfd8527b0133d19b2d9a7b1e
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/tinted/DivineSpamPolicyTest.java
@@ -0,0 +1,162 @@
+package org.bukkit.craftbukkit.tinted;
+
+import com.mojang.brigadier.CommandDispatcher;
+import com.mojang.brigadier.arguments.ArgumentType;
+import com.mojang.brigadier.builder.LiteralArgumentBuilder;
+import com.mojang.brigadier.builder.RequiredArgumentBuilder;
+import io.papermc.paper.brigadier.TagParseCommandSyntaxException;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.util.concurrent.ThreadPoolExecutor;
+import net.minecraft.commands.CommandSourceStack;
+import net.minecraft.commands.Commands;
+import net.minecraft.network.chat.Component;
+import net.minecraft.network.protocol.game.ServerboundCommandSuggestionPacket;
+import net.minecraft.network.protocol.game.ServerboundPlaceRecipePacket;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.server.network.ServerCommandSuggestionsProvider;
+import net.minecraft.server.network.ServerCommonPacketListenerImpl;
+import net.minecraft.server.network.ServerGamePacketListenerImpl;
+import net.minecraft.server.players.PlayerList;
+import net.minecraft.util.TickThrottler;
+import org.bukkit.Bukkit;
+import org.bukkit.event.player.PlayerKickEvent;
+import org.bukkit.support.environment.AllFeatures;
+import org.dreeam.leaf.config.modules.network.SpamChecks;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.spigotmc.SpigotConfig;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@AllFeatures
+class DivineSpamPolicyTest {
+    private final boolean oldDisable = SpamChecks.disableDisconnectSpam;
+    private final boolean oldExclusions = SpigotConfig.enableSpamExclusions;
+    private final int oldTabComplete = SpigotConfig.tabComplete;
+    private MinecraftServer server;
+    private ServerPlayer player;
+    private ServerGamePacketListenerImpl listener;
+
+    @BeforeEach
+    void setup() throws Exception {
+        this.server = mock(MinecraftServer.class);
+        when(this.server.getPlayerList()).thenReturn(mock(PlayerList.class));
+        this.player = mock(ServerPlayer.class);
+        this.listener = mock(ServerGamePacketListenerImpl.class, CALLS_REAL_METHODS);
+        this.listener.player = this.player;
+        this.player.connection = this.listener;
+        Field serverField = ServerCommonPacketListenerImpl.class.getDeclaredField("server");
+        serverField.setAccessible(true);
+        serverField.set(this.listener, this.server);
+        doNothing().when(this.listener).disconnectAsync(any(Component.class), any(PlayerKickEvent.Cause.class));
+        SpigotConfig.enableSpamExclusions = false;
+        SpigotConfig.tabComplete = 0;
+    }
+
+    @AfterEach
+    void restoreConfig() {
+        SpamChecks.disableDisconnectSpam = this.oldDisable;
+        SpigotConfig.enableSpamExclusions = this.oldExclusions;
+        SpigotConfig.tabComplete = this.oldTabComplete;
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void exhaustedTabBudgetStillDropsTheRequest(boolean disableKick) throws Exception {
+        SpamChecks.disableDisconnectSpam = disableKick;
+        this.setThrottler("tabSpamThrottler", false);
+        long submitted = this.suggestionTasks();
+        this.listener.handleCustomCommandSuggestions(new ServerboundCommandSuggestionPacket(1, "test"));
+        assertEquals(submitted, this.suggestionTasks());
+        this.verifyKick(disableKick);
+        verify(this.listener, never()).callAndHandleAsyncTabCompleteEvent(any());
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void oversizedCommandStillDropsTheRequest(boolean disableKick) throws Exception {
+        SpamChecks.disableDisconnectSpam = disableKick;
+        this.setThrottler("tabSpamThrottler", true);
+        long submitted = this.suggestionTasks();
+        this.listener.handleCustomCommandSuggestions(new ServerboundCommandSuggestionPacket(1, "x".repeat(65)));
+        assertEquals(submitted, this.suggestionTasks());
+        this.verifyKick(disableKick);
+        verify(this.listener, never()).callAndHandleAsyncTabCompleteEvent(any());
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void exhaustedRecipeBudgetDoesNotReachWorldOrMenuWork(boolean disableKick) throws Exception {
+        SpamChecks.disableDisconnectSpam = disableKick;
+        this.setThrottler("recipeSpamPackets", false);
+        try (var bukkit = mockStatic(Bukkit.class)) {
+            bukkit.when(Bukkit::isPrimaryThread).thenReturn(false);
+            this.listener.handlePlaceRecipe(mock(ServerboundPlaceRecipePacket.class));
+        }
+        this.verifyKick(disableKick);
+        verify(this.player, never()).level();
+        verify(this.player, never()).resetLastActionTime();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void chatAndCommandSpamStillUpdatesTheSharedBudget(boolean disableKick) throws Exception {
+        SpamChecks.disableDisconnectSpam = disableKick;
+        TickThrottler throttler = mock(TickThrottler.class);
+        Method detect = ServerGamePacketListenerImpl.class.getDeclaredMethod("detectRateSpam", TickThrottler.class, String.class);
+        detect.setAccessible(true);
+        detect.invoke(this.listener, throttler, "test");
+        this.verifyKick(disableKick);
+        verify(throttler).isIncrementAndUnderThreshold();
+    }
+
+    @ParameterizedTest
+    @ValueSource(booleans = {false, true})
+    void malformedTagRequestCompletesWithoutAttemptingSuggestions(boolean disableKick) {
+        SpamChecks.disableDisconnectSpam = disableKick;
+        var dispatcher = spy(new CommandDispatcher<CommandSourceStack>());
+        ArgumentType<String> malformed = reader -> { throw new TagParseCommandSyntaxException("test rejection"); };
+        dispatcher.register(LiteralArgumentBuilder.<CommandSourceStack>literal("test")
+            .then(RequiredArgumentBuilder.<CommandSourceStack, String>argument("nbt", malformed).executes(context -> 1)));
+        Commands commands = mock(Commands.class);
+        when(commands.getDispatcher()).thenReturn(dispatcher);
+        when(this.server.getCommands()).thenReturn(commands);
+        ServerLevel level = mock(ServerLevel.class);
+        when(level.getServer()).thenReturn(this.server);
+        when(this.player.level()).thenReturn(level);
+        when(this.player.createCommandSourceStack()).thenReturn(mock(CommandSourceStack.class));
+        doNothing().when(this.listener).disconnect(any(Component.class), any(PlayerKickEvent.Cause.class));
+        var provider = new ServerCommandSuggestionsProvider(this.player);
+        var result = provider.request("test broken");
+        provider.tick();
+        assertTrue(result.isDone());
+        assertTrue(result.join().isEmpty());
+        verify(dispatcher, never()).getCompletionSuggestions(any());
+        verify(this.listener, times(disableKick ? 0 : 1)).disconnect(any(Component.class), eq(PlayerKickEvent.Cause.SPAM));
+    }
+
+    private void setThrottler(String name, boolean underThreshold) throws Exception {
+        TickThrottler throttler = mock(TickThrottler.class);
+        when(throttler.isIncrementAndUnderThreshold()).thenReturn(underThreshold);
+        Field field = ServerGamePacketListenerImpl.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(this.listener, throttler);
+    }
+
+    private void verifyKick(boolean disabled) {
+        verify(this.listener, times(disabled ? 0 : 1)).disconnectAsync(any(Component.class), eq(PlayerKickEvent.Cause.SPAM));
+    }
+
+    private long suggestionTasks() throws Exception {
+        Field field = ServerGamePacketListenerImpl.class.getDeclaredField("TAB_COMPLETE_EXECUTOR");
+        field.setAccessible(true);
+        return ((ThreadPoolExecutor) field.get(null)).getTaskCount();
+    }
+}
