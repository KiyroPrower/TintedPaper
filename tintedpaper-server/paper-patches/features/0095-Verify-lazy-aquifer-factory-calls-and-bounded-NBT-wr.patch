+    @Test
+    void customFactoriesRemainLazyAndKeepPaperSamplingOrder() {
+        var visited = new java.util.ArrayList<net.minecraft.core.BlockPos>();
+        var factory = new LegacyRandomSource.LegacyPositionalRandomFactory(42) {
+            @Override
+            public net.minecraft.util.RandomSource at(int x, int y, int z) {
+                visited.add(new net.minecraft.core.BlockPos(x, y, z));
+                return super.at(x, y, z);
+            }
+        };
+        var aquifer = create(factory, new DensityVolume(16, 384, 16, 0, -64, 0));
+        assertTrue(visited.isEmpty());
+        aquifer.computeSubstance(0, 0, 0, 1.0);
+        assertTrue(visited.isEmpty());
+        aquifer.computeSubstance(0, 0, 0, -1.0);
+        var expected = new java.util.ArrayList<net.minecraft.core.BlockPos>();
+        for (int x = -1; x <= 0; x++) {
+            for (int y = -1; y <= 1; y++) {
+                for (int z = -1; z <= 0; z++) expected.add(new net.minecraft.core.BlockPos(x, y, z));
+            }
+        }
+        assertEquals(expected, visited);
+        aquifer.computeSubstance(0, 0, 0, -1.0);
+        assertEquals(expected, visited);
+    }
