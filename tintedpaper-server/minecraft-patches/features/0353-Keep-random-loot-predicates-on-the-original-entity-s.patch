diff --git a/net/minecraft/commands/arguments/selector/EntitySelectorParser.java b/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
index 04c1f87bf2163c37a07700588d7b27927fc1d841..522babf6fd6c8bf38bbb2ec4a0bff9008ad9e569 100644
--- a/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
+++ b/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
@@ -92,6 +92,11 @@ public class EntitySelectorParser {
     private final List<Predicate<Entity>> predicates = new ArrayList<>();
     private @Nullable Predicate<Entity> tinted$aliveCheck; // TintedPaper - DPO selector predicate ordering
     private @Nullable List<String> tintedPositiveTags; // TintedPaper - DatapackOptimizer: tag index
+    private boolean tintedTagIndexSafe = true;
+
+    public void tintedDisableTagIndex() {
+        this.tintedTagIndexSafe = false;
+    }
 
     // TintedPaper start - DatapackOptimizer: tag index
     public void addPositiveTag(final String tag) {
@@ -180,7 +185,7 @@ public class EntitySelectorParser {
             this.type,
             this.usesSelectors
         );
-        selector.tintedPositiveTags = this.tintedPositiveTags == null ? null : List.copyOf(this.tintedPositiveTags); // TintedPaper - DatapackOptimizer: tag index
+        selector.tintedPositiveTags = !this.tintedTagIndexSafe || this.tintedPositiveTags == null ? null : List.copyOf(this.tintedPositiveTags); // TintedPaper - DatapackOptimizer: tag index
         return selector;
     }
 
