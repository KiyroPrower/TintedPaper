         return PlacementInfo.create(this.ingredients);
     }
 
+    // DivineMC - keep exact and predicate choices on Paper's full matcher.
+    private static boolean isPlain(final List<Ingredient> ingredients) {
+        for (int i = 0; i < ingredients.size(); i++) {
+            Ingredient ingredient = ingredients.get(i);
+            if (ingredient.stackPredicate != null || ingredient.isExact()) {
+                return false;
+            }
+        }
+        return true;
+    }
+
