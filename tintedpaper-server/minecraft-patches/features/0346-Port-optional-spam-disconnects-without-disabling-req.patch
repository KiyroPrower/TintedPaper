From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Sat, 14 Nov 2026 07:13:42 -0300
Subject: [PATCH] Port optional spam disconnects without disabling request
 limits


diff --git a/net/minecraft/server/network/ServerCommandSuggestionsProvider.java b/net/minecraft/server/network/ServerCommandSuggestionsProvider.java
index 52cb9e845bd18a27cbafd432e5339cf3929b1fc7..95f960d3b14bdba61f4939bc95de9367ac8bde02 100644
--- a/net/minecraft/server/network/ServerCommandSuggestionsProvider.java
+++ b/net/minecraft/server/network/ServerCommandSuggestionsProvider.java
@@ -50,7 +50,8 @@ public class ServerCommandSuggestionsProvider {
                     // Paper start - Handle non-recoverable exceptions
                     if (!parse.getExceptions().isEmpty()
                         && parse.getExceptions().values().stream().anyMatch(e -> e instanceof io.papermc.paper.brigadier.TagParseCommandSyntaxException)) {
-                        this.player.connection.disconnect(net.minecraft.network.chat.Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM);
+                        if (!org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam) this.player.connection.disconnect(net.minecraft.network.chat.Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // TintedPaper - optional spam disconnect, retain parse rejection
+                        request.future.complete(Suggestions.empty().join()); // TintedPaper - empty() is already completed; finish rejection even when the connection stays open
                         return;
                     }
                     // Paper end - Handle non-recoverable exceptions
diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 8add6a7dbd314855910e62cb36a3bafc9b508588..36add1cee7901f934593ab18dccf11463cf1c833 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -882,7 +882,7 @@ public class ServerGamePacketListenerImpl
     public void handleCustomCommandSuggestions(final ServerboundCommandSuggestionPacket packet) {
         // Paper start - throttle tab completions
         if (!this.tabSpamThrottler.isIncrementAndUnderThreshold() && !this.server.getPlayerList().isOp(this.player.nameAndId()) && !this.server.isSingleplayerOwner(this.player.nameAndId())) {
-            this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM);
+            if (!org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam) this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // TintedPaper - optional spam disconnect, retain throttling
             return;
         }
         if (org.spigotmc.SpigotConfig.tabComplete < 0) {
@@ -890,7 +890,7 @@ public class ServerGamePacketListenerImpl
         }
         final int index;
         if (packet.command().length() > 64 && ((index = packet.command().indexOf(' ')) == -1 || index >= 64)) {
-            this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM);
+            if (!org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam) this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // TintedPaper - optional spam disconnect, retain length guard
             return;
         }
         // Paper end - throttle tab completions
@@ -923,7 +923,7 @@ public class ServerGamePacketListenerImpl
             ParseResults<CommandSourceStack> parse = dispatcher.parse(reader, this.player.createCommandSourceStack());
             if (!parse.getExceptions().isEmpty()
                 && parse.getExceptions().values().stream().anyMatch(e -> e instanceof io.papermc.paper.brigadier.TagParseCommandSyntaxException)) {
-                this.player.connection.disconnect(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM);
+                if (!org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam) this.player.connection.disconnect(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // TintedPaper - optional spam disconnect, retain parse rejection
                 return;
             }
 
@@ -2828,6 +2828,7 @@ public class ServerGamePacketListenerImpl
         // throttler.increment();
         if (!throttler.isIncrementAndUnderThreshold()
         // CraftBukkit end - replaced with thread safe throttle
+            && !org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam // TintedPaper - optional spam disconnect
             && !this.server.getPlayerList().isOp(this.player.nameAndId())
             && !this.server.isSingleplayerOwner(this.player.nameAndId())) {
             this.disconnectAsync(Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // Paper - kick event cause & add proper async disconnect
@@ -3591,7 +3592,7 @@ public class ServerGamePacketListenerImpl
         // Paper start - auto recipe limit
         if (!org.bukkit.Bukkit.isPrimaryThread()) {
             if (!this.recipeSpamPackets.isIncrementAndUnderThreshold()) {
-                this.disconnectAsync(net.minecraft.network.chat.Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // Paper - kick event cause // Paper - add proper async disconnect
+                if (!org.dreeam.leaf.config.modules.network.SpamChecks.disableDisconnectSpam) this.disconnectAsync(net.minecraft.network.chat.Component.translatable("disconnect.spam"), org.bukkit.event.player.PlayerKickEvent.Cause.SPAM); // Paper - kick event cause // Paper - add proper async disconnect // TintedPaper - retain throttling
                 return;
             }
         }
