From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 14 Nov 2026 13:41:32 -0300
Subject: [PATCH] Offer UUID-Hex as an optional built-in datapack

Preserve CJDev UUID-Hex function and storage contracts without automatic activation or known-vanilla identity.

diff --git a/net/minecraft/server/packs/repository/ServerPacksSource.java b/net/minecraft/server/packs/repository/ServerPacksSource.java
index cf66cb819bed7b745b00ec8b1c0be0d613015e33..199780815ae8d14a2ea0598a8a3eb79408a3c24a 100644
--- a/net/minecraft/server/packs/repository/ServerPacksSource.java
+++ b/net/minecraft/server/packs/repository/ServerPacksSource.java
@@ -34,6 +34,7 @@ public class ServerPacksSource extends BuiltInPackSource {
     private static final PackSelectionConfig VANILLA_SELECTION_CONFIG = new PackSelectionConfig(false, Pack.Position.BOTTOM, false);
     private static final PackSelectionConfig FEATURE_SELECTION_CONFIG = new PackSelectionConfig(false, Pack.Position.TOP, false);
     private static final Identifier PACKS_DIR = Identifier.withDefaultNamespace("datapacks");
+    private static final String UUID_HEX_PACK = "tintedpaper_uuid_hex";
 
     public ServerPacksSource(final DirectoryValidator validator) {
         super(PackType.SERVER_DATA, createVanillaPackSource(), PACKS_DIR, validator);
@@ -55,7 +56,7 @@ public class ServerPacksSource extends BuiltInPackSource {
 
     @Override
     protected Component getPackTitle(final String id) {
-        return Component.literal(id);
+        return Component.literal(UUID_HEX_PACK.equals(id) ? "UUID-Hex" : id);
     }
 
     @Override
@@ -71,6 +72,9 @@ public class ServerPacksSource extends BuiltInPackSource {
         if ("paper".equals(id)) {
             info = new PackLocationInfo(id, name, PackSource.BUILT_IN, Optional.empty());
             packConfig = new PackSelectionConfig(true, Pack.Position.TOP, true);
+        } else if (UUID_HEX_PACK.equals(id)) {
+            info = new PackLocationInfo(id, name, PackSource.FEATURE, Optional.empty());
+            packConfig = FEATURE_SELECTION_CONFIG;
         } else {
             info = createBuiltInPackLocation(id, name);
             packConfig = FEATURE_SELECTION_CONFIG;
