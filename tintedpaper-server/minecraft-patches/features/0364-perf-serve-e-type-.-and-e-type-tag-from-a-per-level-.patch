@@ -230,6 +230,8 @@ public class EntitySelector {
     // Leaf end - Skip inactive entity for execute
 
     public @Nullable List<String> tintedPositiveTags; // TintedPaper - DatapackOptimizer: tag index
+    public net.minecraft.tags.@Nullable TagKey<net.minecraft.world.entity.EntityType<?>> tintedPositiveTypeTag; // TintedPaper - DatapackOptimizer: type index
+    public boolean tintedTypeIndexSafe = true; // TintedPaper - DatapackOptimizer: false when a loot predicate could consume random state
 
     private void addEntities(final List<Entity> result, final ServerLevel level, final @Nullable AABB absoluteAABB, final Predicate<Entity> predicate) {
         // TintedPaper start - DatapackOptimizer: serve @e[tag=...] from the level's tag index instead of scanning every entity
@@ -239,6 +241,25 @@ public class EntitySelector {
             return;
         }
         // TintedPaper end - DatapackOptimizer: serve @e[tag=...] from the level's tag index instead of scanning every entity
+        // TintedPaper start - DatapackOptimizer: serve @e[type=...] and @e[type=#tag] from the level type index
+        if (absoluteAABB == null && this.tintedTypeIndexSafe && org.dreeam.leaf.config.modules.opt.DatapackOptimizations.selectorTypeIndex
+            && (this.type instanceof EntityType<?> || this.tintedPositiveTypeTag != null) && result.size() < this.getResultLimit()) {
+            final boolean limited = this.getResultLimit() != Integer.MAX_VALUE || this.maxResults != Integer.MAX_VALUE || this.order != ORDER_ARBITRARY;
+            final List<Entity> indexed = limited && !result.isEmpty() ? null
+                : org.dreeam.leaf.util.selector.TypeIndexScan.collect(this.type, this.tintedPositiveTypeTag, level, predicate, limited);
+            if (indexed != null) {
+                if (!limited && org.dreeam.leaf.util.selector.TypeIndexScan.shouldVerify()) {
+                    final List<Entity> nativeResult = new java.util.ArrayList<>();
+                    level.getEntities(this.type, predicate, nativeResult, this.getResultLimit());
+                    org.dreeam.leaf.util.selector.TypeIndexScan.verified(indexed, nativeResult);
+                    result.addAll(nativeResult);
+                } else {
+                    result.addAll(indexed);
+                }
+                return;
+            }
+        }
+        // TintedPaper end - DatapackOptimizer: serve @e[type=...] and @e[type=#tag] from the level type index
         int limit = this.getResultLimit();
         if (result.size() < limit) {
             if (absoluteAABB != null) {
diff --git a/net/minecraft/commands/arguments/selector/EntitySelectorParser.java b/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
index 522babf6fd6c8bf38bbb2ec4a0bff9008ad9e569..9418312566c64a887fc9a6b2f99a7d33a66a44ca 100644
--- a/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
+++ b/net/minecraft/commands/arguments/selector/EntitySelectorParser.java
@@ -92,6 +92,16 @@ public class EntitySelectorParser {
     private final List<Predicate<Entity>> predicates = new ArrayList<>();
     private @Nullable Predicate<Entity> tinted$aliveCheck; // TintedPaper - DPO selector predicate ordering
     private @Nullable List<String> tintedPositiveTags; // TintedPaper - DatapackOptimizer: tag index
+    private @Nullable List<net.minecraft.tags.TagKey<net.minecraft.world.entity.EntityType<?>>> tintedPositiveTypeTags; // TintedPaper - DatapackOptimizer: type index
+
+    // TintedPaper start - DatapackOptimizer: type index
+    public void addPositiveTypeTag(final net.minecraft.tags.TagKey<net.minecraft.world.entity.EntityType<?>> tag) {
+        if (this.tintedPositiveTypeTags == null) {
+            this.tintedPositiveTypeTags = new ArrayList<>(1);
+        }
+        this.tintedPositiveTypeTags.add(tag);
+    }
+    // TintedPaper end - DatapackOptimizer: type index
     private boolean tintedTagIndexSafe = true;
 
     public void tintedDisableTagIndex() {
@@ -186,6 +196,9 @@ public class EntitySelectorParser {
             this.usesSelectors
         );
         selector.tintedPositiveTags = !this.tintedTagIndexSafe || this.tintedPositiveTags == null ? null : List.copyOf(this.tintedPositiveTags); // TintedPaper - DatapackOptimizer: tag index
+        // a single positive type tag only (two: the intersection is left to the native scan); a predicate= option disables it like the tag index
+        selector.tintedPositiveTypeTag = this.tintedTagIndexSafe && this.tintedPositiveTypeTags != null && this.tintedPositiveTypeTags.size() == 1 ? this.tintedPositiveTypeTags.get(0) : null; // TintedPaper - DatapackOptimizer: type index
+        selector.tintedTypeIndexSafe = this.tintedTagIndexSafe; // TintedPaper - DatapackOptimizer: type index
         return selector;
     }
 
