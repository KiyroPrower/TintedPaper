+++ b/com/ishland/c2me/opts/worldgen/general/common/random_instances/RandomUtils.java
@@ -0,0 +1,37 @@
+package com.ishland.c2me.opts.worldgen.general.common.random_instances;
+
+import net.minecraft.util.Mth;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.level.levelgen.LegacyRandomSource;
+import net.minecraft.world.level.levelgen.PositionalRandomFactory;
+import net.minecraft.world.level.levelgen.SingleThreadedRandomSource;
+import net.minecraft.world.level.levelgen.XoroshiroRandomSource;
+import org.jspecify.annotations.Nullable;
+
+// Adapted from C2ME by ishland (MIT), via DivineMC by NONPLAYT.
+public final class RandomUtils {
+    private RandomUtils() {}
+
+    public static @Nullable RandomSource getRandom(PositionalRandomFactory factory) {
+        if (factory.getClass() == XoroshiroRandomSource.XoroshiroPositionalRandomFactory.class) {
+            return new XoroshiroRandomSource(0L, 0L);
+        }
+        if (factory.getClass() == LegacyRandomSource.LegacyPositionalRandomFactory.class) {
+            return new SingleThreadedRandomSource(0L);
+        }
+        return null;
+    }
+
+    public static RandomSource derive(PositionalRandomFactory factory, @Nullable RandomSource random, int x, int y, int z) {
+        if (factory.getClass() == XoroshiroRandomSource.XoroshiroPositionalRandomFactory.class) {
+            var seeds = (XoroshiroRandomSource.XoroshiroPositionalRandomFactory) factory;
+            ((XoroshiroRandomSource) random).setSeed(Mth.getSeed(x, y, z) ^ seeds.seedLo(), seeds.seedHi());
+            return random;
+        }
+        if (factory.getClass() == LegacyRandomSource.LegacyPositionalRandomFactory.class) {
+            random.setSeed(Mth.getSeed(x, y, z) ^ ((LegacyRandomSource.LegacyPositionalRandomFactory) factory).seed());
+            return random;
+        }
+        return factory.at(x, y, z);
+    }
+}
