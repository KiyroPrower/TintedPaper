diff --git a/net/minecraft/server/commands/data/EntityDataAccessor.java b/net/minecraft/server/commands/data/EntityDataAccessor.java
index 2e3790e0cd8a3e4be0326b08d4cc40d9791a00b5..16e0999358c3e11ca770742f8820594e46fef494 100644
--- a/net/minecraft/server/commands/data/EntityDataAccessor.java
+++ b/net/minecraft/server/commands/data/EntityDataAccessor.java
@@ -17,7 +17,9 @@ import net.minecraft.server.commands.ArgProvider;
 import net.minecraft.util.ProblemReporter;
 import net.minecraft.world.entity.Entity;
 import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.ItemStack;
 import net.minecraft.world.level.storage.TagValueInput;
+import net.minecraft.world.level.storage.TagValueOutput;
 import org.slf4j.Logger;
 
 public class EntityDataAccessor implements DataAccessor {
@@ -53,6 +55,36 @@ public class EntityDataAccessor implements DataAccessor {
         return NbtPredicate.getEntityTagToCompare(this.entity);
     }
 
+    public CompoundTag getData(final NbtPathArgument.NbtPath path) {
+        String key = path.tintedTopLevelKey();
+        if (this.getClass() != EntityDataAccessor.class || !org.dreeam.leaf.config.modules.opt.NbtPartial.active()
+            || !org.dreeam.leaf.config.modules.opt.NbtPartial.pathScopedDataReads
+            || org.dreeam.leaf.config.modules.opt.NbtPartial.pathScopedDisabledByMismatch.get() || key == null) {
+            return this.getData();
+        }
+        try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(this.entity.problemPath(), LOGGER)) {
+            TagValueOutput output = TagValueOutput.createWithContext(reporter, this.entity.registryAccess());
+            this.entity.saveWithoutId(new org.dreeam.leaf.util.nbt.KeyFilterValueOutput(output, key::equals));
+            if (NbtPredicate.SELECTED_ITEM_TAG.equals(key) && this.entity instanceof Player player) {
+                ItemStack selected = player.getInventory().getSelectedItem();
+                if (!selected.isEmpty()) {
+                    output.store(NbtPredicate.SELECTED_ITEM_TAG, ItemStack.CODEC, selected);
+                }
+            }
+            CompoundTag partial = output.buildResult();
+            if (org.dreeam.leaf.config.modules.opt.NbtPartial.pathScopedVerified.get() < org.dreeam.leaf.config.modules.opt.NbtPartial.verifySamples) {
+                CompoundTag full = this.getData();
+                if (!java.util.Objects.equals(partial.get(key), full.get(key))) {
+                    org.dreeam.leaf.config.modules.opt.NbtPartial.pathScopedDisabledByMismatch.set(true);
+                    LOGGER.error("Path-scoped entity NBT differed for key {}; scoped data reads are disabled until restart.", key);
+                    return full;
+                }
+                org.dreeam.leaf.config.modules.opt.NbtPartial.pathScopedVerified.incrementAndGet();
+            }
+            return partial;
+        }
+    }
+
     @Override
     public Component getModifiedSuccess() {
         return Component.translatable("commands.data.entity.modified", this.entity.getDisplayName());
