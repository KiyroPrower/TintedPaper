         private static final int[][] SURFACE_SAMPLING_OFFSETS_IN_CHUNKS = new int[][]{
             {0, 0}, {-2, -1}, {-1, -1}, {0, -1}, {1, -1}, {-3, 0}, {-2, 0}, {-1, 0}, {1, 0}, {-2, 1}, {-1, 1}, {0, 1}, {1, 1}
@@ -166,19 +168,24 @@ public interface Aquifer {
             this.c2me$packedBlockPositions = new short[this.aquiferLocationCache.length];
 
             final RandomSource random = com.ishland.c2me.opts.worldgen.general.common.random_instances.RandomUtils.getRandom(positionalRandomFactory);
-            for (int y = 0; y < gridSizeY; y++) {
-                for (int z = 0; z < this.gridSizeZ; z++) {
-                    for (int x = 0; x < this.gridSizeX; x++) {
-                        final int x1 = x + this.minGridX;
-                        final int y1 = y + this.minGridY;
-                        final int z1 = z + this.minGridZ;
-                        RandomSource cellRandom = com.ishland.c2me.opts.worldgen.general.common.random_instances.RandomUtils.derive(positionalRandomFactory, random, x1, y1, z1);
-                        int r0 = cellRandom.nextInt(10);
-                        int r1 = cellRandom.nextInt(9);
-                        int r2 = cellRandom.nextInt(10);
-                        int index = this.getIndex(x1, y1, z1);
-                        this.aquiferLocationCache[index] = BlockPos.asLong(fromGridX(x1, r0), fromGridY(y1, r1), fromGridZ(z1, r2));
-                        this.c2me$packedBlockPositions[index] = (short) ((r0 << 8) | (r1 << 4) | r2);
+            this.lazyRandomFactory = random == null ? positionalRandomFactory : null;
+            if (random == null) {
+                Arrays.fill(this.aquiferLocationCache, Long.MAX_VALUE);
+            } else {
+                for (int y = 0; y < gridSizeY; y++) {
+                    for (int z = 0; z < this.gridSizeZ; z++) {
+                        for (int x = 0; x < this.gridSizeX; x++) {
+                            final int x1 = x + this.minGridX;
+                            final int y1 = y + this.minGridY;
+                            final int z1 = z + this.minGridZ;
+                            RandomSource cellRandom = com.ishland.c2me.opts.worldgen.general.common.random_instances.RandomUtils.derive(positionalRandomFactory, random, x1, y1, z1);
+                            int r0 = cellRandom.nextInt(10);
+                            int r1 = cellRandom.nextInt(9);
+                            int r2 = cellRandom.nextInt(10);
+                            int index = this.getIndex(x1, y1, z1);
+                            this.aquiferLocationCache[index] = BlockPos.asLong(fromGridX(x1, r0), fromGridY(y1, r1), fromGridZ(z1, r2));
+                            this.c2me$packedBlockPositions[index] = (short) ((r0 << 8) | (r1 << 4) | r2);
+                        }
                     }
                 }
             }
@@ -341,6 +348,24 @@ public interface Aquifer {
             int gridX = gridX(blockX + -5);
             int gridY = gridY(blockY + 1);
             int gridZ = gridZ(blockZ + -5);
+            if (this.lazyRandomFactory != null) {
+                // Custom factories retain Paper's lazy sampling and original call order.
+                for (int x = 0; x <= 1; x++) {
+                    for (int y = -1; y <= 1; y++) {
+                        for (int z = 0; z <= 1; z++) {
+                            int index = this.getIndex(gridX + x, gridY + y, gridZ + z);
+                            if (this.aquiferLocationCache[index] == Long.MAX_VALUE) {
+                                RandomSource random = this.lazyRandomFactory.at(gridX + x, gridY + y, gridZ + z);
+                                int r0 = random.nextInt(10);
+                                int r1 = random.nextInt(9);
+                                int r2 = random.nextInt(10);
+                                this.aquiferLocationCache[index] = BlockPos.asLong(fromGridX(gridX + x, r0), fromGridY(gridY + y, r1), fromGridZ(gridZ + z, r2));
+                                this.c2me$packedBlockPositions[index] = (short) ((r0 << 8) | (r1 << 4) | r2);
+                            }
+                        }
+                    }
+                }
+            }
             long closest1 = Long.MAX_VALUE;
             long closest2 = Long.MAX_VALUE;
             long closest3 = Long.MAX_VALUE;
