From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NONPLAYT <nonplay@bxteam.org>
Date: Thu, 10 Jul 2025 04:31:46 +0300
Subject: [PATCH] Crafter 1gt delay


diff --git a/net/minecraft/world/level/block/CrafterBlock.java b/net/minecraft/world/level/block/CrafterBlock.java
index 35aafd51eb16a317c0fda06a7186d59cb263de30..686113283f61e9f94c8f53bd083b03bebe22b59d 100644
--- a/net/minecraft/world/level/block/CrafterBlock.java
+++ b/net/minecraft/world/level/block/CrafterBlock.java
@@ -71,7 +71,7 @@ public class CrafterBlock extends BaseEntityBlock {
         boolean isTriggered = state.getValue(TRIGGERED);
         BlockEntity blockEntity = level.getBlockEntity(pos);
         if (shouldTrigger && !isTriggered) {
-            level.scheduleTick(pos, this, 4);
+            level.scheduleTick(pos, this, org.dreeam.leaf.config.modules.gameplay.BlockMechanics.crafterOneTickDelay ? 1 : CRAFTING_TICK_DELAY); // DivineMC - Crafter 1gt delay
             level.setBlock(pos, state.setValue(TRIGGERED, true), Block.UPDATE_CLIENTS);
             this.setBlockEntityTriggered(blockEntity, true);
         } else if (!shouldTrigger && isTriggered) {
@@ -120,7 +120,7 @@ public class CrafterBlock extends BaseEntityBlock {
     @Override
     public void setPlacedBy(final Level level, final BlockPos pos, final BlockState state, final @Nullable LivingEntity by, final ItemStack itemStack) {
         if (state.getValue(TRIGGERED)) {
-            level.scheduleTick(pos, this, 4);
+            level.scheduleTick(pos, this, org.dreeam.leaf.config.modules.gameplay.BlockMechanics.crafterOneTickDelay ? 1 : CRAFTING_TICK_DELAY); // DivineMC - Crafter 1gt delay
         }
     }
 
