+    // TintedPaper start - DivineMC: Optimize Raids
+    /** A shared ominous banner for comparisons only; the stack must never be given to an entity or changed. */
+    public static ItemStack ominousBannerForComparison(final net.minecraft.world.level.Level level) {
+        if (level instanceof ServerLevel serverLevel) {
+            ItemStack banner = serverLevel.ominousBanner;
+            if (banner == null) {
+                banner = getOminousBannerInstance(level.registryAccess().lookupOrThrow(Registries.BANNER_PATTERN));
+                serverLevel.ominousBanner = banner;
+            }
+            return banner;
+        }
+        return getOminousBannerInstance(level.registryAccess().lookupOrThrow(Registries.BANNER_PATTERN));
+    }
+    // TintedPaper end - DivineMC: Optimize Raids
+
