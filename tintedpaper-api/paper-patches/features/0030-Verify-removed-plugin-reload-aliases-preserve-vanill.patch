From: Codex <codex@openai.com>
Date: Sat, 14 Nov 2026 00:21:52 -0300
Subject: [PATCH] Verify removed plugin reload aliases preserve vanilla
 registration and API linkage


diff --git a/src/test/java/org/bukkit/command/ReloadRegistrationTest.java b/src/test/java/org/bukkit/command/ReloadRegistrationTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..d43a23205a2248760f81c9e43d380ce3e98333b8
--- /dev/null
+++ b/src/test/java/org/bukkit/command/ReloadRegistrationTest.java
@@ -0,0 +1,37 @@
+package org.bukkit.command;
+
+import java.util.HashMap;
+import org.bukkit.Server;
+import org.bukkit.command.defaults.ReloadCommand;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.mock;
+
+class ReloadRegistrationTest {
+    @Test
+    void defaultAndClearedMapsDoNotRegisterPluginReloadAliases() {
+        var map = new SimpleCommandMap(mock(Server.class), new HashMap<>());
+        assertNull(map.getCommand("bukkit:reload"));
+        assertNull(map.getCommand("bukkit:rl"));
+        map.clearCommands();
+        assertNull(map.getCommand("bukkit:reload"));
+        assertNull(map.getCommand("bukkit:rl"));
+    }
+
+    @Test
+    void vanillaReloadRegistrationAndLegacyApiLinkageRemainAvailable() {
+        var map = new SimpleCommandMap(mock(Server.class), new HashMap<>());
+        Command vanilla = new Command("reload") {
+            @Override
+            public boolean execute(CommandSender sender, String label, String[] args) {
+                return true;
+            }
+        };
+        assertTrue(map.register("minecraft", vanilla));
+        assertSame(vanilla, map.getCommand("reload"));
+        assertSame(vanilla, map.getCommand("minecraft:reload"));
+        assertEquals("reload", new ReloadCommand("reload").getName());
+        assertFalse(ReloadCommand.RELOADING_DISABLED_MESSAGE.isEmpty());
+    }
+}
